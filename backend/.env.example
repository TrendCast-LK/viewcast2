# Copy this file to .env and adjust as needed.

# Random secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# How long an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite by default — swap for Postgres/MySQL later, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/viewcast
DATABASE_URL=sqlite:///./viewcast.db

# Comma-separated list of origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YouTube Data API v3 key, used to fetch a user's channel data at signup and
# from the Channel page's "Refresh" button. Get one at
# https://console.cloud.google.com — create a project, enable "YouTube Data
# API v3" under APIs & Services > Library, then create an API key under
# APIs & Services > Credentials. Free tier is 10,000 quota units/day (a
# channel lookup costs 1, the search fallback for /c/ URLs costs 100).
# Without this set, channel lookups fail gracefully with an explanatory
# message rather than breaking signup.
YOUTUBE_API_KEY=
